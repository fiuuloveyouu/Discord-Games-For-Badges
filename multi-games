    function validateGames() {
        const ids = new Set(GAMES.map(game => game.id));
        const sum = GAMES.reduce((total, game) => total + game.hours, 0);
        if (GAMES.length !== EXPECTED_COUNT || ids.size !== GAMES.length) {
            throw new Error(`${LABEL} Game table must hold ${EXPECTED_COUNT} unique games (has ${GAMES.length}, ${ids.size} unique).`);
        }
        if (GAMES.some(game => !Number.isFinite(game.hours) || game.hours <= 0 || !game.exe)) {
            throw new Error(`${LABEL} Every game needs an exe and positive hours.`);
        }
        if (Math.abs(sum - TOTAL_HOURS) > 0.05) {
            throw new Error(`${LABEL} Game hours add up to ${sum.toFixed(1)}h, expected ${TOTAL_HOURS}h.`);
        }
    }

    // Claimed history is shared by all three scripts and kept per Discord account, so running any
    // mix of them (or one twice) never sends a game twice. Discord hides window.localStorage from
    // the console, so it's reached through a hidden same-origin iframe, which keeps the history
    // after a reload. It's also mirrored on window in case that fails.
    let storageFrame = null;

    function getStorage() {
        try {
            if (window.localStorage) return window.localStorage;
        } catch (_) {}
        try {
            if (!storageFrame) {
                storageFrame = document.createElement("iframe");
                storageFrame.style.display = "none";
                document.body.appendChild(storageFrame);
            }
            return storageFrame.contentWindow?.localStorage ?? null;
        } catch (_) {
            return null;
        }
    }

    // Removes the iframe once pending (a run that may still be saving its result) settles.
    function releaseStorage(pending) {
        Promise.resolve(pending).catch(() => {}).finally(() => {
            try { storageFrame?.remove(); } catch (_) {}
            storageFrame = null;
        });
    }

    function getClaimedSet(userId) {
        const memory = window[CLAIMED_MEMORY_KEY] ?? {};
        const ids = new Set(Array.isArray(memory[userId]) ? memory[userId] : []);
        for (const key of LEGACY_MEMORY_KEYS) {
            if (Array.isArray(window[key])) for (const id of window[key]) ids.add(String(id));
        }
        const storage = getStorage();
        for (const key of [`${CLAIMED_KEY}:${userId}`, ...LEGACY_CLAIMED_KEYS]) {
            try {
                const saved = JSON.parse(storage?.getItem(key) || "[]");
                if (Array.isArray(saved)) for (const id of saved) ids.add(String(id));
            } catch (_) {}
        }
        return ids;
    }

    function saveClaimedSet(userId, set) {
        const ids = Array.from(set);
        window[CLAIMED_MEMORY_KEY] = { ...(window[CLAIMED_MEMORY_KEY] ?? {}), [userId]: ids };
        try {
            getStorage()?.setItem(`${CLAIMED_KEY}:${userId}`, JSON.stringify(ids));
        } catch (_) {}
    }

    function resetClaimedSet() {
        delete window[CLAIMED_MEMORY_KEY];
        for (const key of LEGACY_MEMORY_KEYS) delete window[key];
        try {
            const storage = getStorage();
            if (!storage) return;
            const keys = [];
            for (let i = 0; i < storage.length; i++) {
                const key = storage.key(i);
                if (key && (key.startsWith(`${CLAIMED_KEY}:`) || LEGACY_CLAIMED_KEYS.includes(key))) keys.push(key);
            }
            for (const key of keys) storage.removeItem(key);
        } catch (_) {}
    }
    // ===== End of game table =====

    const CHANGE_MS = CONFIG.rotateMinutes * 60 * 1000; // Rich Presence switches game on this interval, in table order
    const STAGGER_MINUTES = 25;
    const LAUNCH_OFFSET_MS = 300;          // gap between the first heartbeat and launch_game
    const FAKE_PID = 50000;
    // Discord drops a play session longer than 24h completely, so a longer game goes as back-to-back
    // sessions of at most 23h, SESSION_GAP_MS apart.
    const MAX_SESSION_MS = 23 * 3600 * 1000;
    const SESSION_GAP_MS = 10 * 60 * 1000;

    const CLIENT_VERSION = "1.0.9253";
    const CLIENT_BUILD_NUMBER = 594031;
    const NATIVE_BUILD_NUMBER = 88414;
